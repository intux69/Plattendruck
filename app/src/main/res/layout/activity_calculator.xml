<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Plattendruck-Versuch DIN 18134"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_step_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schritt 1: Einstellungen"
            android:textSize="18sp"
            android:layout_marginBottom="24dp"
            android:textColor="?attr/colorPrimary" />

        <!-- STEP 1: SETTINGS -->
        <LinearLayout
            android:id="@+id/layout_step_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plattendurchmesser [mm]:" />
            <EditText
                android:id="@+id/edit_diameter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="300"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verhältnis (Messeinrichtung):" />
            <EditText
                android:id="@+id/edit_lever_ratio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="2.0" />
        </LinearLayout>

        <!-- STEP 2: FIRST LOADING -->
        <LinearLayout
            android:id="@+id/layout_step_load1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Erstbelastung (Setzung in 0.01 mm)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
                <TableRow>
                    <TextView android:text="0.08 MPa: " />
                    <EditText android:id="@+id/edit_load_1" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.16 MPa: " />
                    <EditText android:id="@+id/edit_load_2" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.25 MPa: " />
                    <EditText android:id="@+id/edit_load_3" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.33 MPa: " />
                    <EditText android:id="@+id/edit_load_4" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.42 MPa: " />
                    <EditText android:id="@+id/edit_load_5" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.50 MPa: " />
                    <EditText android:id="@+id/edit_load_6" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- STEP 3: UNLOADING -->
        <LinearLayout
            android:id="@+id/layout_step_unload"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entlastung (Setzung in 0.01 mm)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
                <TableRow>
                    <TextView android:text="0.25 MPa: " />
                    <EditText android:id="@+id/edit_unload_1" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.12 MPa: " />
                    <EditText android:id="@+id/edit_unload_2" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.00 MPa: " />
                    <EditText android:id="@+id/edit_unload_3" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- STEP 4: SECOND LOADING -->
        <LinearLayout
            android:id="@+id/layout_step_load2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zweitbelastung (Setzung in 0.01 mm)"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1">
                <TableRow>
                    <TextView android:text="0.08 MPa: " />
                    <EditText android:id="@+id/edit_reload_1" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.16 MPa: " />
                    <EditText android:id="@+id/edit_reload_2" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.25 MPa: " />
                    <EditText android:id="@+id/edit_reload_3" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.33 MPa: " />
                    <EditText android:id="@+id/edit_reload_4" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
                <TableRow>
                    <TextView android:text="0.42 MPa: " />
                    <EditText android:id="@+id/edit_reload_5" android:inputType="numberDecimal" android:hint="Setzung" />
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <!-- STEP 5: RESULTS -->
        <LinearLayout
            android:id="@+id/layout_step_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_result_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/result_chart"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- NAVIGATION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_prev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Zurück"
                android:visibility="gone"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Weiter" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
